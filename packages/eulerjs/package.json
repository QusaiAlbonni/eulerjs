{
  "name": "eulerjs",
  "version": "0.1.0",
  "description": "Rigid body physics for three.js, with exact mass properties for arbitrary closed meshes",
  "type": "module",
  "license": "MIT",
  "author": "Qusay Albonni",
  "homepage": "https://qusaialbonni.github.io/eulerjs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QusaiAlbonni/eulerjs.git",
    "directory": "packages/eulerjs"
  },
  "bugs": {
    "url": "https://github.com/QusaiAlbonni/eulerjs/issues"
  },
  "keywords": [
    "physics",
    "three",
    "threejs",
    "rigid body",
    "simulation"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extend": {
      "types": "./dist/extend.d.ts",
      "default": "./dist/extend.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.166.0"
  }
}
