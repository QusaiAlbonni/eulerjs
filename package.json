{
  "name": "eulerjs-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/marine",
    "packages/bvh",
    "packages/scene",
    "packages/vehicle",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @eulerjs/core && npm run build -w @eulerjs/marine && npm run build -w @eulerjs/bvh && npm run build -w @eulerjs/scene && npm run build -w @eulerjs/vehicle",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:xpbd": "EULER_SOLVER=xpbd vitest run --config vitest.bench.config.ts",
    "dev": "npm run dev -w sailboat-example",
    "dev:basics": "npm run dev -w basics-examples",
    "dev:city": "npm run dev -w city-example",
    "dev:wedding": "npm run dev -w wedding-example",
    "dev:ocean": "npm run dev -w ocean-example",
    "dev:three-addons": "npm run dev -w three-addons-examples",
    "dev:f1": "npm run dev -w f1-example",
    "check": "npm run lint && npm run typecheck && npm run coverage && npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "docs:dev": "npm run docs:api && node scripts/build-examples.mjs && vitepress dev docs",
    "docs:examples": "node scripts/build-examples.mjs",
    "docs:api": "typedoc",
    "docs:build": "node scripts/build-site.mjs",
    "docs:preview": "vitepress preview docs",
    "logo": "vite scripts/logo"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@dimforge/rapier3d-simd-compat": "^0.21.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "cannon-es": "^0.20.0",
    "eslint": "^10.12.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.44"
  }
}
