{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/core/src/extend.ts",
    "packages/marine/src/index.ts",
    "packages/marine/src/webgpu/index.ts",
    "packages/vehicle/src/index.ts",
    "packages/bvh/src/index.ts",
    "packages/scene/src/index.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "name": "eulerjs API",
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/QusaiAlbonni/eulerjs/blob/main/packages/{path}#L{line}",
  "basePath": ".",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "docsRoot": "docs",
  "readme": "none",
  "entryFileName": "index",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "sort": ["kind", "alphabetical"],
  "useCodeBlocks": true,
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "enumMembersFormat": "table",
  "sidebar": { "autoConfiguration": true, "format": "vitepress", "pretty": true, "collapsed": true },
  "indexFormat": "table",
  "pageTitleTemplates": { "index": "API reference", "module": "{name}", "member": "{name}" },
  "validation": { "notExported": false, "invalidLink": false }
}
